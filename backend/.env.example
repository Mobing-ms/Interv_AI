DATABASE_URL=sqlite:///./intervai.db
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_REQUIRED=false
# Google OAuth 2.0 Web Client ID (from Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://127.0.0.1:5174,http://127.0.0.1:5173
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
