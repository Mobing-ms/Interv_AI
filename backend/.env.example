# =============================================================================
# IntervAI Backend Environment Configuration
# =============================================================================

# ENV=production refuses to start unless: JWT_SECRET_KEY is random and >= 32 chars,
# DEBUG/DEV_MODE are false, LLM/STT providers are real (not "mock") with keys, and
# TURNSTILE_SECRET_KEY is set. "mock" providers are for local dev/tests and log a loud warning.

# Server Environment & Debug
ENV=development                          # "development", "staging", "production"
DEBUG=true                               # Set to false in production
PUBLIC_API_URL=http://localhost:8000     # Production public URL (e.g. "https://api.intervai.com")

# Set true only behind a reverse proxy you control (trusts X-Forwarded-For/-Proto/-Host)
TRUST_PROXY_HEADERS=false

# Runtime data dir (sqlite db, uploads, recordings, TTS cache); outside the source tree.
# Default: <repo>/.data/backend
# DATA_DIR=/var/lib/intervai

# Database & Cache
# Empty -> sqlite file inside DATA_DIR. Production: postgresql://user:password@host:5432/intervai
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
# Generate with: openssl rand -hex 32
# Empty in development -> ephemeral random key (tokens reset on restart). Required in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_REQUIRED=false
DEV_MODE=true                            # Set to false in production

# Google OAuth 2.0 Web Client ID (from Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Production CORS Allowed Origins (comma-separated, without trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app

# Object Storage Backend (Recordings, Audio Chunks, Video Manifests)
# Options: "local" (local disk storage) or "s3" (AWS S3, Cloudflare R2, MinIO)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=                         # e.g. https://<account_id>.r2.cloudflarestorage.com for Cloudflare R2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=intervai-recordings
S3_REGION_NAME=auto
RECORDING_RETENTION_DAYS=30
GUEST_RETENTION_HOURS=24

# Speech-to-Text (STT) Provider
# Options: "mock" (offline dev), "groq" (recommended for free tier: fast, zero RAM), "openai", "deepgram", "local_whisper"
STT_PROVIDER=mock
STT_API_KEY=                             # Groq API key or OpenAI API key
STT_MODEL=whisper-large-v3-turbo

# LLM Service Configuration
# Options: "mock" (offline dev), "openai", "gemini", "groq"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Guest Practice Mode & Abuse Protection
GUEST_MAX_SESSIONS_PER_IP_PER_DAY=3
GUEST_MAX_QUESTIONS=3
GUEST_DURATION_MINUTES=10
TURNSTILE_SECRET_KEY=                    # Cloudflare Turnstile secret key (required in production; empty = disabled in dev)

# Operational endpoints (/session/maintenance/cleanup-retention, /guest/cleanup) need
# header X-Maintenance-Token equal to this. Empty = endpoints disabled.
MAINTENANCE_TOKEN=
