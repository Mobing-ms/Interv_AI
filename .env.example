# =============================================================================
# IntervAI Frontend Environment Configuration
# =============================================================================

# Backend API Base URL (HTTP/REST)
# In development: http://localhost:8000
# In production: https://api.yourdomain.com or https://your-backend.onrender.com
# Note: WebSockets will automatically connect to wss:// in production.
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (from Google Cloud Console Credentials)
# Must match Authorized JavaScript origins in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudflare Turnstile Site Key (for bot protection on guest practice & sign up)
# Testing dummy key: 1x00000000000000000000AA (always passes)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
